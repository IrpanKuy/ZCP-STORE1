rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper profil pengguna & RBAC (superadmin, admin, karyawan)
    // Akun Firebase Authentication yang belum memiliki dokumen di /users/{uid} otomatis dianggap Superadmin.
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return request.auth != null && (!hasUserDoc() || userDocData().active != false);
    }

    function isSuperAdmin() {
      return isActiveUser() && (!hasUserDoc() || userDocData().role == 'superadmin');
    }

    function isAdmin() {
      return isActiveUser() && hasUserDoc() && userDocData().role == 'admin';
    }

    function isKaryawan() {
      return isActiveUser() && hasUserDoc() && userDocData().role == 'karyawan';
    }

    function isAdminOrSuper() {
      return isSuperAdmin() || isAdmin();
    }

    function isNonEmptyString(val) {
      return val is string && val.size() > 0 && val.size() <= 200;
    }

    // Admin tidak boleh membatalkan pesanan yang sudah berstatus selesai (hanya Superadmin)
    // dan menandai selesai wajib memiliki kontribusiTotal == jumlahProduk.
    function adminPesananUpdateAllowed() {
      return resource.data.statusSelesai != true
        ? (
            request.resource.data.statusSelesai != true
            || request.resource.data.get('kontribusiTotal', 0) == request.resource.data.jumlahProduk
          )
        : (
            request.resource.data.statusSelesai == true
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sisiProgress', 'updatedAt'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tanggalMulai', 'tanggalDeadline', 'updatedAt'])
              || (
                resource.data.completedByUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'kontribusi',
                  'kontribusiUids',
                  'kontribusiTotal',
                  'updatedAt'
                ])
              )
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anggapSablonSelesai', 'updatedAt'])
            )
          );
    }

    // Karyawan hanya boleh memperbarui status selesai / progres sablon / kontribusi pada pesanan;
    // tidak boleh membatalkan pesanan yang sudah selesai (hanya Superadmin),
    // serta hanya boleh memperbarui kontribusi pesanan selesai bila menyetujui request Borongan sebagai penyelesai.
    function karyawanPesananUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'statusSelesai',
          'completedAt',
          'completedByUid',
          'completedByName',
          'sisiProgress',
          'kontribusi',
          'kontribusiUids',
          'kontribusiTotal',
          'updatedAt'
        ])
        && (
          resource.data.statusSelesai != true
            ? (
                (!('kontribusiTotal' in request.resource.data) || request.resource.data.kontribusiTotal <= resource.data.jumlahProduk)
                && (
                  request.resource.data.statusSelesai != true
                  || request.resource.data.get('kontribusiTotal', 0) == resource.data.jumlahProduk
                )
              )
            : (
                request.resource.data.statusSelesai == true
                && (
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sisiProgress', 'updatedAt'])
                  || (
                    resource.data.completedByUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'kontribusi',
                      'kontribusiUids',
                      'kontribusiTotal',
                      'updatedAt'
                    ])
                  )
                )
              )
        );
    }

    // Karyawan hanya boleh memperbarui checklist print / status selesai pada sablon
    // dan hanya boleh membatalkan status selesai jika dirinya yang menandai selesai.
    function karyawanSablonUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'perulanganChecks',
          'perulanganCheckMeta',
          'statusSelesai',
          'completedAt',
          'completedByUid',
          'completedByName',
          'updatedAt'
        ])
        && (
          resource.data.statusSelesai != true
          || request.resource.data.statusSelesai == true
          || resource.data.completedByUid == request.auth.uid
        );
    }

    // Koleksi Akun Karyawan & Admin (hanya Superadmin yang boleh membuat/mengubah)
    match /users/{userId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isSuperAdmin();
    }

    // Konfigurasi AI Gemini (berisi API Key: hanya Superadmin & Admin dapat membaca, hanya Superadmin dapat mengubah)
    match /app_settings/ai_config {
      allow read: if isAdminOrSuper();
      allow create, update, delete: if isSuperAdmin();
    }

    // Konfigurasi Google Drive API (berisi OAuth Token: hanya Superadmin & Admin dapat membaca, hanya Superadmin dapat mengubah)
    match /app_settings/drive_config {
      allow read: if isAdminOrSuper();
      allow create, update, delete: if isSuperAdmin();
    }

    // Koleksi Pengaturan Aplikasi umum (hanya Superadmin yang boleh mengubah)
    match /app_settings/{settingId} {
      allow read: if settingId != 'ai_config' && settingId != 'drive_config' && isActiveUser();
      allow create, update, delete: if isSuperAdmin();
    }

    // Koleksi Log Aktivitas (semua akun aktif dapat menulis log miliknya, hanya Superadmin dapat membaca)
    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isActiveUser()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Master Data Produk (namaProduk + array namaSisi minimal 1 item + templateSisi opsional)
    match /master_produk/{produkId} {
      allow read, delete: if isActiveUser();
      allow create, update: if isActiveUser()
        && isNonEmptyString(request.resource.data.namaProduk)
        && request.resource.data.namaSisi is list
        && request.resource.data.namaSisi.size() > 0
        && request.resource.data.namaSisi.size() <= 50
        && (
          !('templateSisi' in request.resource.data)
          || (
            request.resource.data.templateSisi is list
            && request.resource.data.templateSisi.size() > 0
            && request.resource.data.templateSisi.size() <= 50
          )
        );
    }

    // Master Data Expedisi (namaExpedisi)
    match /master_expedisi/{expedisiId} {
      allow read, delete: if isActiveUser();
      allow create, update: if isActiveUser()
        && isNonEmptyString(request.resource.data.namaExpedisi);
    }

    // Master Data Asal Pesanan (namaAsal)
    match /master_asal_pesanan/{asalId} {
      allow read, delete: if isActiveUser();
      allow create, update: if isActiveUser()
        && isNonEmptyString(request.resource.data.namaAsal);
    }

    // Master Data Kategori Produk (namaKategori)
    match /master_kategori_produk/{kategoriId} {
      allow read, delete: if isActiveUser();
      allow create, update: if isActiveUser()
        && isNonEmptyString(request.resource.data.namaKategori);
    }

    // Koleksi Pesanan (Karyawan read-only di menu Pesanan; hanya Superadmin boleh membatalkan Selesai)
    match /pesanan/{pesananId} {
      allow read: if isActiveUser();
      allow create, delete: if isAdminOrSuper();
      allow update: if isSuperAdmin()
        || (isAdmin() && adminPesananUpdateAllowed())
        || (isKaryawan() && karyawanPesananUpdateAllowed());
    }

    // Pengajuan Perubahan Kontribusi (Borongan)
    match /kontribusi_requests/{requestId} {
      allow read: if isSuperAdmin()
        || (isActiveUser() && request.auth.uid in resource.data.involvedUids);
      allow create: if isActiveUser()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.completedByUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.auth.uid in request.resource.data.involvedUids;
      allow update: if (isSuperAdmin() || (isActiveUser() && resource.data.completedByUid == request.auth.uid))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isSuperAdmin();
    }

    // Koleksi Manajemen Sablon (Karyawan hanya boleh checklist/selesai/batal selesai milik sendiri)
    match /sablon/{sablonId} {
      allow read: if isActiveUser();
      allow create, delete: if isAdminOrSuper();
      allow update: if isAdminOrSuper() || (isKaryawan() && karyawanSablonUpdateAllowed());
    }

    // Log Perubahan AI Chatbot (maks 20 terakhir untuk audit & fitur Rollback AI)
    match /ai_change_logs/{logId} {
      allow read, create, update, delete: if isAdminOrSuper();
    }

    // Blokir seluruh akses ke koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
